# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` for local development.
# NOTE: Phase 1 ships an honest, deliberately un-hardened baseline. iter-09
# (A02 Security Misconfiguration) is where DEBUG, CORS and Swagger exposure
# get locked down. Do NOT treat these defaults as production-safe.
# ---------------------------------------------------------------------------

# Application version. The version gate in scripts/lib/common.sh compares this
# against the value reported by the running API's /health endpoint.
VERSION=0.1.0

# --- API service ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info
# Deliberately permissive baseline; hardened in iter-09.
DEBUG=true
CORS_ALLOW_ORIGINS=*
# Per-environment Swagger exposure policy (tightened in iter-09).
EXPOSE_DOCS=true

# --- Web service ---
WEB_HOST=0.0.0.0
WEB_PORT=8080
API_BASE_URL=http://api:8000

# --- Database ---
POSTGRES_USER=backoffice
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=backoffice
POSTGRES_HOST=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://backoffice:change_me_local_only@database:5432/backoffice

# --- Security scanner (OWASP ZAP) ---
ZAP_PORT=8090

# --- Test toolkit ---
# TRANSPORT selects black-box (http) vs white-box (in-process) execution.
TOOLKIT_TRANSPORT=http
TOOLKIT_BASE_URL=http://api:8000
